{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "git": {
    "deploymentEnabled": {
      "1.21.1/fabric/dev": false,
      "1.21.1/fabric/prod": true
    }
  }
}
